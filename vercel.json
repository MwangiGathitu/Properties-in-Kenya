{
  "rewrites": [
    { "source": "/css/:path*", "destination": "/public/css/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/shared/:path*", "destination": "/public/shared/:path*" },
    { "source": "/", "destination": "/apps/admin/dashboard.html" }
  ]
}
